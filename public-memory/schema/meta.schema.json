{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C78+ Meta Schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "created_at",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "pdf": {
          "type": [
            "string",
            "null"
          ]
        },
        "md": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pdf"
      ]
    }
  }
}